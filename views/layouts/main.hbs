<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Quản lý sách - {{student.studentId}}</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      max-width: 1100px;
      margin: 30px auto;
      padding: 0 16px;
      line-height: 1.6;
      background: #f5f7fb;
    }

    main {
      background: white;
      padding: 24px;
      border-radius: 12px;
    }

    form {
      display: grid;
      gap: 10px;
      max-width: 450px;
    }

    input, button {
      padding: 10px;
      font-size: 16px;
    }

    button {
      background: #2563eb;
      color: white;
      border: none;
      cursor: pointer;
    }

    .table-wrap {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th, td {
      padding: 10px;
      border: 1px solid #ddd;
      text-align: left;
    }

    th {
      background: #eef2ff;
    }

    footer {
      text-align: center;
      margin-top: 24px;
    }
  </style>
</head>

<body>
  <main>
    {{{body}}}
  </main>

  <footer>
    <strong>{{student.fullName}}</strong>
    | MSSV: {{student.studentId}}
    | VAT áp dụng: {{vatPercent}}%
  </footer>
</body>
</html>